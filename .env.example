# =========================
# PostgreSQL principal
# =========================
PG_HOST=""
PG_PORT="5432"
PG_DATABASE=""
PG_USER=""
PG_PASSWORD=""
PG_CONNECT_TIMEOUT=20

# Tabela que será localizada via pg_catalog.pg_tables.
PG_TARGET_SCHEMA=pg_catalog
PG_TARGET_TABLE=pg_type

# =========================
# OpenSearch
# =========================
OPENSEARCH_DASHBOARDS_HOST="" 
OPENSEARCH_HOST=""
OPENSEARCH_PORT=9200
OPENSEARCH_USER=""
OPENSEARCH_PASSWORD=""
OPENSEARCH_USE_SSL=true
OPENSEARCH_VERIFY_CERTS=false

# =========================
# Seleção de clientes
# =========================
TEST_ENV=hml
CLIENT_SELECTION_SOURCE=database
OCTOPUS_CLIENT_CREDENTIALS={}

# Exemplo usando referências seguras a variáveis do .env:
# CLIENT_SELECTION_SOURCE=credentials
# OCTOPUS_CLIENT_CREDENTIALS={"ursula":{"endpoint":"https://octopus.ursula.clavissecurity.com","client_id":"clavis","username":"$URSULA_OPENSEARCH_USER","password":"$URSULA_OPENSEARCH_PASSWORD"},"comercial":{"endpoint":"https://demo.clavissecurity.com","client_id":"comercial","username":"$COMERCIAL_OPENSEARCH_USER","password":"$COMERCIAL_OPENSEARCH_PASSWORD"}}

# =========================
# AWS SES
# =========================
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# =========================
# SMTP
# =========================
SMTP_SERVER=""
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM=""
SMTP_RECIPIENTS=""